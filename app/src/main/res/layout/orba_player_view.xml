<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView en vez de SurfaceView: al deslizar entre videos no deja el cuadro anterior "pegado".
     Sin carátula: el tamaño lo decide solo el video, nunca una imagen. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:use_artwork="false"
    app:artwork_display_mode="off"
    app:show_buffering="never"
    app:shutter_background_color="@android:color/black"
    app:keep_content_on_player_reset="false" />
